#!/usr/bin/env bash
set -euo pipefail

readonly SERVICE="slickchook.service"
readonly SERVICE_GROUP="slickchook"
readonly PLUGIN_ROOT="/var/lib/slickchook/plugins"
readonly BACKUP_ROOT="/var/backups/slickchook/plugin-packages"
readonly LOCK_FILE="/run/lock/slickchook-plugin.lock"
readonly SLICKCHOOK_BIN="/opt/slickchook/slickchook"

STAGE=""

die() {
  echo "error: $*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  slickchook-plugin install [--force-rebuild] <plugin-directory> [plugin-name]
  slickchook-plugin remove <plugin-name>
  slickchook-plugin list

A plugin package is a directory named for the plugin and containing a matching
<plugin-name>.toml manifest. Installs and removals are validated by restarting
the MCP service; a failed service start automatically rolls back the change.

For a package with a Dockerfile, --force-rebuild passes --no-cache to
docker build. Without it, an install whose Dockerfile and build context
are unchanged reuses Docker's cached layers, which is correct and
expected - not a bug - since the resulting image is identical either way.
Use --force-rebuild when you specifically want to bypass that cache, for
example to rule it out while diagnosing a suspected stale image.
EOF
}

cleanup() {
  if [[ -n ${STAGE} && -d ${STAGE} ]]; then
    rm -rf -- "${STAGE}"
  fi
}

trap cleanup EXIT

valid_name() {
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]]
}

timestamped_backup() {
  local name=$1
  printf '%s/%s-%s-%s' "${BACKUP_ROOT}" "${name}" "$(date -u +%Y%m%dT%H%M%SZ)" "$$"
}

normalize_package() {
  local directory=$1
  chown -R root:"${SERVICE_GROUP}" "${directory}"
  find "${directory}" -type d -exec chmod 0750 {} +
  find "${directory}" -type f -exec chmod 0640 {} +
}

check_container_image() {
  local manifest=$1 name=$2 image
  image=$(sed -n 's/^container[[:space:]]*=[[:space:]]*"\([^"]*\)"[[:space:]]*$/\1/p' "${manifest}" | head -1)
  [[ -n ${image} ]] || die "${name} manifest has no container image"
  [[ ${image} != *$'\n'* && ${image} != *$'\r'* ]] || die "invalid container image in ${name} manifest"
  if ! docker image inspect "${image}" >/dev/null 2>&1; then
    echo "Required container image is not present: ${image}" >&2
    echo "Build or pull it before installing:" >&2
    if [[ -f ${STAGE}/Dockerfile ]]; then
      echo "  sudo docker build --pull -t ${image} ${source}" >&2
    else
      echo "  sudo docker pull ${image}" >&2
    fi
    die "container image unavailable for ${name}"
  fi
  echo "${image}"
}

# Reads a manifest's declared `[[assets]]` as unit-separator-delimited
# `source<0x1F>dest<0x1F>min_size_bytes` lines (source is empty when unset).
# A tab won't work here: bash's `read` treats tab as "IFS whitespace" even
# when IFS is set to just a tab, so a leading empty field (source, often
# empty) gets silently stripped instead of preserved, shifting every other
# field left by one. Unit separator isn't IFS whitespace, so empty fields
# are preserved regardless of position. Manifest schema validation
# (including path-safety checks on source/dest) already happened inside
# --print-assets itself via the same load_manifest() the service uses.
print_assets() {
  local manifest=$1
  "${SLICKCHOOK_BIN}" --print-assets "${manifest}"
}

# Before building a plugin's own image, verify every asset the manifest
# declares a `source` for is actually present in the staged package — so a
# package copied or checked out without a required bundled file (e.g. a
# wordlist) fails installation immediately instead of silently building a
# broken image from whatever the Dockerfile's COPY happens to find.
check_assets_in_package() {
  local stage=$1 manifest=$2 name=$3 source dest min_size
  while IFS=$'\x1f' read -r source dest min_size; do
    [[ -n ${dest} ]] || continue
    [[ -n ${source} ]] || continue
    local candidate="${stage}/${source}"
    [[ -f ${candidate} ]] \
      || die "${name} declares asset source \`${source}\` (for ${dest}) but it is missing from the package"
    local size
    size=$(stat -c '%s' "${candidate}")
    [[ ${size} -ge ${min_size} ]] \
      || die "${name} asset source \`${source}\` is ${size} bytes, below its declared minimum of ${min_size}"
  done < <(print_assets "${manifest}")
}

# After a plugin's image is built or confirmed pulled, verify every declared
# asset actually landed at `dest` inside it, regardless of `source` — this
# also catches a Dockerfile whose COPY drifted out of sync with the manifest,
# or an upstream image that never bundled what the manifest expects. Prints
# an error and returns non-zero rather than dying directly, since the
# freshly-built-image call site needs to restore the previous image's tag
# before aborting installation.
check_assets_in_image() {
  local image=$1 manifest=$2 name=$3 dest min_size source
  while IFS=$'\x1f' read -r source dest min_size; do
    [[ -n ${dest} ]] || continue
    local cid tmpfile size
    cid=$(docker create "${image}") || { echo "error: ${name}: failed to create a container from ${image} to verify asset ${dest}" >&2; return 1; }
    tmpfile=$(mktemp)
    if ! docker cp "${cid}:${dest}" "${tmpfile}" >/dev/null 2>&1; then
      docker rm "${cid}" >/dev/null 2>&1 || true
      rm -f "${tmpfile}"
      echo "error: ${name}: declared asset ${dest} is missing from the built image ${image}" >&2
      return 1
    fi
    size=$(stat -c '%s' "${tmpfile}")
    docker rm "${cid}" >/dev/null 2>&1 || true
    rm -f "${tmpfile}"
    if [[ ${size} -lt ${min_size} ]]; then
      echo "error: ${name}: declared asset ${dest} in ${image} is ${size} bytes, below its declared minimum of ${min_size}" >&2
      return 1
    fi
  done < <(print_assets "${manifest}")
}

restart_service() {
  systemctl restart "${SERVICE}"
  systemctl is-active --quiet "${SERVICE}"
}

install_plugin() {
  local force_rebuild=$1
  local source=$2
  local name=${3:-$(basename -- "${source}")}
  local destination backup local_image rollback_image had_previous=false had_previous_image=false

  valid_name "${name}" || die "invalid plugin name: ${name}"
  [[ -d ${source} ]] || die "plugin directory does not exist: ${source}"
  source=$(cd -- "${source}" && pwd)
  [[ -f ${source}/${name}.toml ]] \
    || die "plugin package must contain ${name}.toml"
  if find "${source}" -mindepth 1 ! -type f ! -type d -print -quit | grep -q .; then
    die "plugin packages may contain only regular files and directories"
  fi

  destination="${PLUGIN_ROOT}/${name}"
  backup=$(timestamped_backup "${name}")
  STAGE=$(mktemp -d "/var/lib/slickchook/.plugin-stage-${name}.XXXXXX")
  cp -a "${source}/." "${STAGE}/"
  normalize_package "${STAGE}"

  local image manifest="${STAGE}/${name}.toml"
  if [[ -f ${STAGE}/Dockerfile ]]; then
    local_image="slickchook-plugin/${name}:local"
    rollback_image="slickchook-plugin/${name}:rollback-$$"
    grep -Eq "^container[[:space:]]*=[[:space:]]*\"${local_image}\"[[:space:]]*$" \
      "${manifest}" \
      || die "a package with a Dockerfile must declare container = \"${local_image}\""
    check_assets_in_package "${STAGE}" "${manifest}" "${name}"
    if docker image inspect "${local_image}" >/dev/null 2>&1; then
      docker tag "${local_image}" "${rollback_image}"
      had_previous_image=true
    fi
    local build_args=(--pull --tag "${local_image}")
    if [[ ${force_rebuild} == true ]]; then
      build_args+=(--no-cache)
      echo "Building plugin-owned image ${local_image} (--force-rebuild: bypassing Docker's build cache)."
    else
      echo "Building plugin-owned image ${local_image}."
    fi
    docker build "${build_args[@]}" "${STAGE}"
    image="${local_image}"
    if ! check_assets_in_image "${local_image}" "${manifest}" "${name}"; then
      if [[ ${had_previous_image} == true ]]; then
        docker tag "${rollback_image}" "${local_image}"
        docker image rm "${rollback_image}" >/dev/null || true
      fi
      die "${name} was not installed: built image is missing a declared asset"
    fi
  else
    image=$(check_container_image "${manifest}" "${name}")
    check_assets_in_image "${image}" "${manifest}" "${name}" \
      || die "${name} was not installed: pulled image is missing a declared asset"
  fi

  systemctl stop "${SERVICE}"
  if [[ -e ${destination} ]]; then
    install -d -o root -g root -m 0700 "${BACKUP_ROOT}"
    mv "${destination}" "${backup}"
    had_previous=true
  fi
  mv "${STAGE}" "${destination}"
  STAGE=""

  if ! restart_service; then
    echo "Plugin validation failed; rolling back ${name}." >&2
    systemctl stop "${SERVICE}" || true
    install -d -o root -g root -m 0700 "${BACKUP_ROOT}"
    mv "${destination}" "${backup}.failed"
    if [[ ${had_previous} == true ]]; then
      mv "${backup}" "${destination}"
    fi
    if [[ ${had_previous_image} == true ]]; then
      docker tag "${rollback_image}" "${local_image}"
    fi
    systemctl start "${SERVICE}" || true
    die "${name} was not installed; inspect journalctl -u ${SERVICE}"
  fi

  if [[ ${had_previous_image} == true ]]; then
    docker image rm "${rollback_image}" >/dev/null || true
  fi

  echo "Installed plugin ${name}."
  if [[ ${had_previous} == true ]]; then
    echo "Previous package: ${backup}"
  fi
}

remove_plugin() {
  local name=$1
  local destination backup

  valid_name "${name}" || die "invalid plugin name: ${name}"
  destination="${PLUGIN_ROOT}/${name}"
  [[ -d ${destination} ]] || die "plugin is not installed: ${name}"
  backup=$(timestamped_backup "${name}")
  install -d -o root -g root -m 0700 "${BACKUP_ROOT}"

  systemctl stop "${SERVICE}"
  mv "${destination}" "${backup}"
  if ! restart_service; then
    echo "Service validation failed; restoring ${name}." >&2
    systemctl stop "${SERVICE}" || true
    mv "${backup}" "${destination}"
    systemctl start "${SERVICE}" || true
    die "${name} was not removed; inspect journalctl -u ${SERVICE}"
  fi

  echo "Removed plugin ${name}. Backup: ${backup}"
}

[[ ${EUID} -eq 0 ]] || die "run as root (for example: sudo slickchook-plugin ...)"
command -v flock >/dev/null || die "flock is required (install util-linux)"
getent group "${SERVICE_GROUP}" >/dev/null || die "Slickchook is not installed"
systemctl cat "${SERVICE}" >/dev/null 2>&1 || die "${SERVICE} is not installed"
install -d -o root -g "${SERVICE_GROUP}" -m 0750 "${PLUGIN_ROOT}"

exec 9>"${LOCK_FILE}"
flock -x 9

case ${1:-} in
  install)
    shift
    force_rebuild=false
    positional=()
    for arg in "$@"; do
      case ${arg} in
        --force-rebuild) force_rebuild=true ;;
        *) positional+=("${arg}") ;;
      esac
    done
    [[ ${#positional[@]} -ge 1 && ${#positional[@]} -le 2 ]] || { usage; exit 2; }
    install_plugin "${force_rebuild}" "${positional[0]}" "${positional[1]:-}"
    ;;
  remove)
    [[ $# -eq 2 ]] || { usage; exit 2; }
    remove_plugin "$2"
    ;;
  list)
    [[ $# -eq 1 ]] || { usage; exit 2; }
    find "${PLUGIN_ROOT}" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '%f\n' | sort
    ;;
  *)
    usage
    exit 2
    ;;
esac
