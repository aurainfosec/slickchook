# Secrets and local configuration
.env
.env.*
!.env.example
*.env
!.env.example
*.token
*.jwt
*.pem
*.key
*.p12
*.pfx
*.crt
*.secret
# gitignore matching is case-sensitive, and this project's own convention
# for secret files is SCREAMING_SNAKE_CASE (e.g. plugin-secrets.env's
# `SHODAN_API_KEY=...` lines, see RUNNER.md) - each pattern below is
# listed in both cases actually likely to appear as a filename.
*credentials*
*CREDENTIALS*
*password*
*PASSWORD*
*passwd*
*PASSWD*
*secret*
*SECRET*
*apikey*
*APIKEY*
*api-key*
*API-KEY*
*api_key*
*API_KEY*
# plugin-secrets.env belongs on the deployment host at
# /etc/slickchook/plugin-secrets.env (see RUNNER.md), never in this repo -
# already caught by *.env/*secret* above, listed for clarity.
plugin-secrets.env
/etc/slickchook/

# SSH, TLS, cloud, and local credential material
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.kubeconfig
.aws/
.docker/
.config/gcloud/

# Local backups and generated reports
/backups/
*.bak
*.dump
*.sql.gz
*.log
*.core
core
core.*

# Dependency and tool caches
node_modules/
.npm/
.cache/
.pytest_cache/
__pycache__/
*.py[cod]

# Editor and OS files
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
